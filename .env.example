# Build variables (Vite exposes VITE_* to the app at build time).
# For local builds copy this file to .env.local; for the GitHub Pages build set them as
# repository variables (Settings → Secrets and variables → Actions → Variables).
# Everything in the bundle is public: the PIN only keeps booth visitors out of the staff menu.

# URL of tsp-boards for the "Rundreise" place on the start map: its gallery,
# https://ls11ae.github.io/tsp-boards/ on GitHub Pages. Outside kiosk mode it opens in a new tab; in kiosk
# mode the app shows tsp-boards' event mode (#kiosk) in a frame, which must be on the same origin so the
# kiosk timeout sees the input there. For the offline booth package serve tsp-boards' build at /tsp-boards/
# next to the app and set /tsp-boards/. Leave empty to hide the place.
VITE_TSP_BOARDS_URL=

# PIN for the staff menu (any digits, e.g. four). Leave empty to open the staff menu without a PIN.
VITE_STAFF_PIN=
